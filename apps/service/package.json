{
  "name": "@better-mailer/service",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime-agnostic HTTP service that renders Elements templates and delivers them through any provider.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-mailer/delivery": "workspace:*",
    "@better-mailer/emails": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@unlayer/react-elements": "^0.1.20",
    "hono": "^4.12.32",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.11"
  }
}
