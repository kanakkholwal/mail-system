{
  "name": "@better-mailer/studio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Gallery and payload workbench for the Elements template catalogue.",
  "scripts": {
    "ensure:emails": "test -f ../../packages/emails/dist/index.js || bun run --filter '@better-mailer/emails' build",
    "predev": "bun run ensure:emails",
    "dev": "next dev --turbopack",
    "prebuild": "bun run ensure:emails",
    "build": "next build",
    "prestart": "bun run ensure:emails",
    "start": "next start",
    "pretypecheck": "bun run ensure:emails",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-mailer/emails": "workspace:*",
    "@unlayer/react-elements": "^0.1.20",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2"
  }
}
