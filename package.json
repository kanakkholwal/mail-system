{
  "name": "mail-server",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md}\"",
    "build:package": "node scripts/build-package.js",
    "publish:npm": "npm run build:package && cd package && npm publish --access public",
    "publish:github": "npm run build:package && cd package && npm publish --registry=https://npm.pkg.github.com",
    "pack:local": "npm run build:package && cd package && npm pack"
  },
  "dependencies": {
    "@react-email/components": "0.0.31",
    "@react-email/tailwind": "1.0.4",
    "next": "^16.1.1",
    "nodemailer": "^6.9.16",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "eslint": "9",
    "eslint-config-next": "16.1.1",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.0"
}