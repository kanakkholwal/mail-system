{
  "name": "mail-system",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "build:packages": "bun run --filter '@better-mailer/emails' build && bun run --filter '@better-mailer/delivery' build",
    "build": "bun run build:packages && bun run --filter './apps/*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "verify": "bun run build:packages && bun run typecheck && bun run test",
    "render": "bun run --filter '@better-mailer/emails' render",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
