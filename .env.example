# Copy to .env. Only MAIL_FROM_EMAIL is required; everything else has a default.

# --- Identity ---
MAIL_FROM_EMAIL=hello@example.com
MAIL_FROM_NAME=Example
# MAIL_REPLY_TO=support@example.com

# --- Transport ---
# console | smtp | resend | postmark | sendgrid | ses
MAIL_TRANSPORT=console
# console writes each message to disk instead of sending it
MAIL_OUTPUT_DIR=.mail-out

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_POOL=true

# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound
# SENDGRID_API_KEY=
# AWS_REGION=eu-west-1
# SES_CONFIGURATION_SET=

# --- Service ---
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Comma separated. Required when NODE_ENV=production: an open /v1/send is an open relay.
# SERVICE_API_KEYS=replace-with-a-long-random-value

# Comma separated origins. Unset means no CORS headers, the right default for a keyed API.
# CORS_ORIGINS=http://localhost:3000

# Only enable behind a proxy you control; x-forwarded-for is forgeable.
TRUST_PROXY=false

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Simultaneous provider calls, then how many may wait before the service sheds load.
SEND_CONCURRENCY=8
SEND_QUEUE_MAX=64
SEND_TIMEOUT_MS=15000
SEND_MAX_RECIPIENTS=50

MAX_BODY_BYTES=524288
READY_CACHE_MS=15000
SHUTDOWN_GRACE_MS=10000
