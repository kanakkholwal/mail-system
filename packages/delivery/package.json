{
  "name": "@better-mailer/delivery",
  "version": "2.0.0",
  "description": "Provider-agnostic email delivery. One Transport interface over SMTP, Resend, SES, Postmark, SendGrid and a console driver.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "author": "Kanak Kholwal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanakkholwal/mail-system.git",
    "directory": "packages/delivery"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-sesv2": ">=3",
    "nodemailer": ">=6"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    },
    "@aws-sdk/client-sesv2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "nodemailer": "^9.0.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.11"
  }
}
