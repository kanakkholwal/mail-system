{
    "name": "mailer-easy",
    "version": "1.0.0",
    "description": "Type-safe email templates with React Email and Zod validation",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./templates/*": {
            "types": "./dist/templates/*/index.d.ts",
            "import": "./dist/templates/*/index.mjs",
            "require": "./dist/templates/*/index.js"
        },
        "./kit/*": {
            "types": "./dist/kit/*/index.d.ts",
            "import": "./dist/kit/*/index.mjs",
            "require": "./dist/kit/*/index.js"
        },
        "./renderer": {
            "types": "./dist/renderer.d.ts",
            "import": "./dist/renderer.mjs",
            "require": "./dist/renderer.js"
        },
        "./registry": {
            "types": "./dist/registry.d.ts",
            "import": "./dist/registry.mjs",
            "require": "./dist/registry.js"
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup"
    },
    "keywords": [
        "email",
        "react-email",
        "nodemailer",
        "templates",
        "transactional-email",
        "typescript",
        "type-safe",
        "zod",
        "email-templates",
        "mailer"
    ],
    "author": "Kanak Kholwal",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/kanakkholwal/mail-system.git",
        "directory": "emails"
    },
    "bugs": {
        "url": "https://github.com/kanakkholwal/mail-system/issues"
    },
    "homepage": "https://github.com/kanakkholwal/mail-system#readme",
    "peerDependencies": {
        "@react-email/components": ">=0.0.31",
        "react": ">=18.0.0",
        "zod": ">=3.0.0"
    },
    "dependencies": {
        "@react-email/components": "0.0.31",
        "@react-email/tailwind": "1.0.4",
        "nodemailer": "^6.9.16",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/node": "^22",
        "@types/nodemailer": "^6.4.17",
        "@types/react": "^19",
        "react": "^19.2.3",
        "tsup": "^8.0.0",
        "typescript": "^5"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}